# Copy values into your shell or your server's environment; never commit secrets.
# Required for direct CLI use; start.sh defaults to .local/data beside the repository.
OUTREACH_DATA_DIR=/absolute/path/to/outreach-data
# Needed for remote serving (32+ random characters). Local start prints a session key.
OUTREACH_ACCESS_TOKEN=
# Optional: import an EXISTING Apify dataset; no Actor runs are started.
APIFY_TOKEN=
# Optional: enable AI generation; without these, the template mode works offline.
OPENAI_API_KEY=
OPENAI_MODEL=
